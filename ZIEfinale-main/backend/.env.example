NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/zie-db
JWT_SECRET=your_jwt_secret_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FRONTEND_URL=http://localhost:4200
EXCHANGE_RATE=0.015
# ====== SECURITY CONFIGURATION ======
# CORS & Production Domain Configuration
# Set this to your production domain for CORS validation
PRODUCTION_DOMAIN=https://zie.co.zw

# Optional: Additional allowed redirect domains (comma-separated)
# Only add if you have secondary approved domains
ADDITIONAL_ALLOWED_REDIRECTS=https://www.zie.co.zw

# ====== SECURITY FEATURES ENABLED ======
# 1. CORS Protection - Only allows requests from PRODUCTION_DOMAIN
# 2. Redirect URL Validation - Prevents open redirect vulnerabilities
# 3. File Access Control - Users can only access files they uploaded